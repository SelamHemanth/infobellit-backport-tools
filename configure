#!/usr/bin/env bash
set -euo pipefail

OUT_FILE="${1:-.configure}"

prompt() {
  local prompt_text="$1"
  local default="$2"
  local required="${3:-0}"
  local resp
  if [ -n "$default" ]; then
    while true; do
      read -r -p "${prompt_text} [${default}]: " resp
      resp="${resp:-$default}"
      if [ "$required" -eq 1 ] && [ -z "$resp" ]; then
        echo "This value is required."
      else
        printf '%s' "$resp"
        return 0
      fi
    done
  else
    while true; do
      read -r -p "${prompt_text}: " resp
      if [ "$required" -eq 1 ] && [ -z "$resp" ]; then
        echo "This value is required."
      else
        printf '%s' "$resp"
        return 0
      fi
    done
  fi
}

echo "Create configuration file: ${OUT_FILE}"

LINUX_SRC_PATH="$(prompt 'Linux source code path' '/home/jenkins/linux' 1)"
SIGNER_NAME="$(prompt 'Signed-off-by name' 'Hemanth Selam' 1)"
SIGNER_EMAIL="$(prompt 'Signed-off-by email' 'Hemanth.Selam@amd.com' 1)"
ANBZ_ID="$(prompt 'ANBZ ID' '26498' 1)"
NUM_PATCHES="$(prompt 'Number of patches to apply (N)' '5' 1)"

if ! printf '%s' "${NUM_PATCHES}" | grep -qE '^[0-9]+$'; then
  echo "NUM_PATCHES must be a positive integer" >&2
  exit 2
fi

cat > "${OUT_FILE}" <<EOF
LINUX_SRC_PATH='${LINUX_SRC_PATH}'
SIGNER_NAME='${SIGNER_NAME}'
SIGNER_EMAIL='${SIGNER_EMAIL}'
ANBZ_ID='${ANBZ_ID}'
NUM_PATCHES='${NUM_PATCHES}'
EOF

echo "Wrote configuration to ${OUT_FILE}"
echo "Run ./run.sh --build --config ${OUT_FILE} from your workspace to generate patches and build"

